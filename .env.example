# Servidor
NODE_ENV=development
PORT=3000

# Gemini (AI Studio) — generativa de imágenes (Nano Banana)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.1-flash-lite-image
# Timeout por llamada a Gemini (ms) y reintentos ante fallos transitorios
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_RETRIES=2

# Seguridad — claves válidas para X-API-Key (separadas por coma)
API_KEYS=dev-key-1,dev-key-2

# Rate limit por IP
RATE_LIMIT_PER_MINUTE=60
# Detrás de proxy (Nginx/LB): 'true' o número de hops (p.ej. 1)
TRUST_PROXY=false

# Persistencia (dedup)
STORAGE_DIR=storage/processed
DB_PATH=storage/better-image.db
# GC de ficheros huérfanos: intervalo en minutos (0 = solo al arranque)
GC_INTERVAL_MINUTES=720

# Límite de upload (límite conservador de esta API: 7MB)
MAX_FILE_SIZE_MB=7

# Producción: API_KEYS vacío. Solo hashes SHA-256 de claves aleatorias de 32 bytes.
# Un id estable permite rotar claves sin perder acceso a los resultados.
# CLIENTS_JSON=[{"id":"tienda-1","keyHashes":["<sha256-hex>"],"profiles":{"default":"Center product on white background, square composition."}}]
CLIENTS_JSON=[]
# Admisión antes de cargar archivos; presupuesto máximo de buffers ~ requests * batch * MB
MAX_ACTIVE_REQUESTS=4
GEMINI_CONCURRENCY=2
MAX_BATCH_FILES=5

# Cola persistente (una sola instancia). Upload incremental de hasta 100 fotos por job.
MAX_PENDING_IMAGES=1000
JOB_UPLOAD_TTL_MINUTES=60
JOB_WORKERS=2
# Recargas manuales: SHA-256 de una clave administrativa distinta a las de clientes.
# ADMIN_API_KEY_HASH=<sha256-hex>

# Mercado Pago Checkout Pro (opcional; desactivado si no hay token).
# Configura TODOS los valores antes de activar. Precio por paquete en unidades enteras de moneda.
# MP_ACCESS_TOKEN=<secret>
# MP_WEBHOOK_SECRET=<secret>
# MP_COLLECTOR_ID=<seller-id>
MP_LIVE_MODE=false
# MP_CURRENCY=COP
# CREDIT_PACK_SIZE=100
# CREDIT_PACK_PRICE=<precio-del-paquete>
# PUBLIC_BASE_URL=https://api.example.com
